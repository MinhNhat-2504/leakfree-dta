# Data and results are regenerated by the pipeline, never committed -- with the
# small, verifiable artifacts carved out below.
#
# The negations need the directories un-ignored one level at a time. Git does
# not descend into a directory its parent pattern already excluded, so a bare
# "!data/splits/*.json" under "data/**" silently matches nothing. That is how the
# split manifests ended up absent from a repository whose README said it
# released them.
data/**
!data/*/
!data/**/.gitkeep
!data/README.md

# Split definitions: specification, fold counts and content digests. A few KB,
# enough to verify a rebuilt split. The full per-row assignment is 385 MB of
# JSON and goes in the archival deposit instead; scripts/export_split_artifacts.py
# writes both.
!data/splits/
!data/splits/*/
!data/splits/*/_index.json

# Frozen evaluation subsets: which rows an external run was asked to score.
!data/external/
!data/external/*/
!data/external/*/*/
!data/external/*/*/*/
!data/external/*/*/*/subset_manifest.json
results/**
!results/**/.gitkeep

# Split manifests ARE the published artifact -- keep them.
!data/splits/*.json
!data/splits/*.csv.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Model checkpoints and logs
*.pt
*.pth
*.ckpt
wandb/
lightning_logs/
mlruns/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Large source documents
*.pdf
!paper/**/*.pdf

# Cloned external repositories and their workspaces. Large, and reconstructable
# from the pinned commit recorded in each run's provenance.
data/external/**/repo/

# Continue IDE agent config: local tooling, not project source.
.continue/
