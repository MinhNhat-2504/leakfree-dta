# Data and results are regenerated by the pipeline, never committed.
data/**
!data/**/.gitkeep
!data/README.md
results/**
!results/**/.gitkeep

# Split manifests ARE the published artifact -- keep them.
!data/splits/*.json
!data/splits/*.csv.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Model checkpoints and logs
*.pt
*.pth
*.ckpt
wandb/
lightning_logs/
mlruns/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Large source documents
*.pdf
!paper/**/*.pdf
